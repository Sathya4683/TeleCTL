# Frontend (web/) npm config — checked in so every contributor gets the
# same behaviour. The Next.js 16 / React 19 / Tailwind v4 stack is
# finicky about peer-dep resolution, so we lock to a single strategy.

# Use exact versions instead of ^ for stability across CI / local.
save-exact=false

# Don't auto-create a package-lock.json per-runner if it's missing —
# CI pulls it via `npm ci`, which already requires it.
package-lock=true

# Default registry. Override via env (e.g. for an airgapped build).
# registry=https://registry.npmjs.org/

# Avoid noisy funding + audit output in CI logs.
fund=false
audit=false