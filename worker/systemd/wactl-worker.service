[Unit]
Description=WACTL worker — long-polls SQS + dispatches async commands
Documentation=https://example.com/wactl
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=wactl
Group=wactl
WorkingDirectory=/opt/wactl
EnvironmentFile=-/etc/wactl/worker.env
ExecStart=/opt/wactl/.venv/bin/python -m worker.main
Restart=on-failure
RestartSec=10
KillSignal=SIGTERM
TimeoutStopSec=30
# Hardening: no new privs, write only to tmp, protect /home
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/log/wactl /tmp
PrivateTmp=true

[Install]
WantedBy=multi-user.target
