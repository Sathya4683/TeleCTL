# ============================================================================
# WACTL — Environment Variables (Telegram bot edition)
# ============================================================================
#
# Copy this file to `.env` for local development (the file is git-ignored).
#
# In production these values come from environment variables on the
# Lambda function and the EC2 worker. NO Secrets Manager / SSM used —
# we keep it simple and free-tier friendly.
# ============================================================================

# ----------------------------------------------------------------------------
# AWS — common
# ----------------------------------------------------------------------------
# Region for all AWS clients. Matches Terraform var.region.
AWS_REGION=us-east-1

# ----------------------------------------------------------------------------
# Telegram bot
# ----------------------------------------------------------------------------
# Bot token issued by @BotFather (looks like "123456:ABCDEF...").
# Set this as a plain env var on both the Lambda and the EC2 worker.
TELEGRAM_BOT_TOKEN=
# Optional: when set, the webhook verifies the X-Telegram-Bot-Api-Secret-Token
# header against this value. Empty = no header verification.
# Generate one with: openssl rand -hex 32
TELEGRAM_WEBHOOK_SECRET_TOKEN=

# ----------------------------------------------------------------------------
# Storage
# ----------------------------------------------------------------------------
S3_MEDIA_BUCKET=wactl-media-dev
# Releases bucket (worker.tar.gz + lambda.zip land here).
S3_RELEASES_BUCKET=wactl-releases-dev

# ----------------------------------------------------------------------------
# Queue
# ----------------------------------------------------------------------------
# FIFO queue URL — provided by `terraform output sqs_jobs_queue_url`.
SQS_JOBS_QUEUE_URL=
# DynamoDB dedup table.
DYNAMODB_DEDUP_TABLE=wactl-dedup
# Dedup TTL in seconds (default 7 days).
DEDUP_TTL_SECONDS=604800

# ----------------------------------------------------------------------------
# Gemini (used by /pdf-audio TTS)
# ----------------------------------------------------------------------------
GEMINI_API_KEY=
GEMINI_TEXT_MODEL=gemini-2.0-flash
GEMINI_TTS_VOICE=en-US-Journey-D

# ----------------------------------------------------------------------------
# Application
# ----------------------------------------------------------------------------
ENV=dev                         # dev | staging | prod
LOG_LEVEL=INFO                  # DEBUG | INFO | WARNING | ERROR
