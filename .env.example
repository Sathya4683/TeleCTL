# ============================================================================
# WACTL — Environment Variables
# ============================================================================
#
# This file documents EVERY environment variable used by the backend.
# Copy to `.env` for local development (the file is git-ignored).
#
# In production these values come from:
#   • AWS Secrets Manager (sensitive values)
#   • Lambda / EC2 environment variables (non-sensitive values)
#
# DO NOT commit a populated .env file.
# ============================================================================

# ----------------------------------------------------------------------------
# AWS — common
# ----------------------------------------------------------------------------
# Region for all AWS clients. Matches Terraform var.region.
AWS_REGION=us-east-1
# Optional: profile name for local development with aws-vault / aws sso.
# AWS_PROFILE=wactl-dev

# ----------------------------------------------------------------------------
# WhatsApp Cloud API
# ----------------------------------------------------------------------------
# Stable Meta Graph API version. Used for outbound message URLs.
WHATSAPP_API_VERSION=v21.0
# Phone Number ID for the WhatsApp Business number that sends + receives.
WHATSAPP_PHONE_NUMBER_ID=__populate_in_secrets_manager__
# WABA (WhatsApp Business Account) ID — informational.
WHATSAPP_WABA_ID=
# Permanent access token (system user token). Stored in Secrets Manager.
# Reference: WHATSAPP_ACCESS_TOKEN_SECRET=wactl/whatsapp/access-token
WHATSAPP_ACCESS_TOKEN_SECRET=wactl/whatsapp/access-token
# App secret used to verify X-Hub-Signature-256 HMAC.
WHATSAPP_APP_SECRET_SECRET=wactl/whatsapp/app-secret
# Webhook verification token. Set in Meta dashboard, must match.
WHATSAPP_VERIFY_TOKEN_SECRET=wactl/whatsapp/verify-token

# ----------------------------------------------------------------------------
# Storage
# ----------------------------------------------------------------------------
S3_MEDIA_BUCKET=wactl-media-dev
# Worker release artifacts (built by CI).
S3_RELEASES_BUCKET=wactl-releases-dev

# ----------------------------------------------------------------------------
# Queues / state
# ----------------------------------------------------------------------------
# SQS jobs queue URL. Provided by Terraform output.
SQS_JOBS_QUEUE_URL=
# DynamoDB dedup table name.
DYNAMODB_DEDUP_TABLE=wactl-dedup-dev
# Dedup TTL in seconds (default 7 days; matches Meta webhook retry window).
DEDUP_TTL_SECONDS=604800

# ----------------------------------------------------------------------------
# External services
# ----------------------------------------------------------------------------
# Gemini API key. Stored in Secrets Manager.
GEMINI_API_KEY_SECRET=wactl/gemini/api-key
# Gemini model names (overridable per-command).
GEMINI_TEXT_MODEL=gemini-2.0-flash
GEMINI_TTS_VOICE=en-US-Journey-D

# GitHub personal access token (optional; only for /github-pr).
# Use a fine-grained token with public_repo + metadata:read.
GITHUB_TOKEN_SECRET=wactl/github/token

# ----------------------------------------------------------------------------
# Application
# ----------------------------------------------------------------------------
ENV=dev                         # dev | staging | prod
LOG_LEVEL=INFO                  # DEBUG | INFO | WARNING | ERROR
# When 1, fail fast on signature / dedup / parse errors. 0 = log + ignore.
STRICT_WEBHOOK=1